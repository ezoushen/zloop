      "timeout": 180,
      "launch": [
        "{python}",
        "{plugin_root}/benchmarks/workflows/case.py",
        "launch",
        "source-drift",
        "{workspace}",
        "{evidence}"
      ],
      "doctor": [
        "{python}",
        "{plugin_root}/benchmarks/workflows/case.py",
        "doctor",
        "source-drift",
        "{workspace}",
        "{evidence}"
      ],
      "drive": [
        "{python}",
        "{plugin_root}/benchmarks/workflows/case.py",
        "drive",
        "source-drift",
        "{workspace}",
        "{evidence}"
