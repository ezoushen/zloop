{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\" codex",
            "timeout": 5,
            "statusMessage": "zloop: load bootstrap and host adapter"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/herdr_launch.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/read_only_writes.py\" codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*spawn_agent|.*followup_task|.*delegate_task|.*subagent",
        "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/managed_launch.py\"", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/yield_gate.py\" codex",
            "timeout": 20,
            "statusMessage": "zloop: yield gate for live workers"
          }
        ]
      }
    ]
  }
}
